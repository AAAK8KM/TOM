compilation_database_dir: build

output_directory: diagrams

diagrams:
  class_tree:
    type: class

    glob:
      - "lib/*.hpp"
      - "src/*.cpp"
      - "src/**/*.hpp"

    include:
      paths:
        - lib
        - src
      
      relationships:
        - inheritance
        - friendship
        - dependency

    exclude:
      namespaces:
        - std

    generate_packages: false
    generate_method_arguments: full
    generate_concept_requirements: yes

    plantuml:
      before:
        - "!pragma layout elk"
        - "skinparam classAttributeIconSize 0"
        - "top to bottom direction"
